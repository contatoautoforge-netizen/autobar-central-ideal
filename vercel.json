{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "buildCommand": "node build.mjs",
  "outputDirectory": "public",
  "headers": [
    {"source":"/produto/:path*","headers":[{"key":"Cache-Control","value":"public, max-age=0, must-revalidate"}]},
    {"source":"/marketing.js","headers":[{"key":"Cache-Control","value":"public, max-age=0, must-revalidate"}]}
  ],
  "redirects": [
    { "source": "/", "destination": "/produto/autobar", "permanent": false }
  ],
  "rewrites": [
    { "source": "/produto/autobar", "destination": "/produto/autobar/index.html" },
    { "source": "/produto/agrobar", "destination": "/produto/agrobar/index.html" },
    { "source": "/checkout", "destination": "/checkout/index.html" },
    { "source": "/pagamento-pix", "destination": "/pagamento-pix/index.html" },
    { "source": "/politicas", "destination": "/politicas/index.html" },
    { "source": "/rastreio", "destination": "/rastreio/index.html" }
  ]
}
